# Pi Dashboard 2.0 Backend Config (BEISPIEL)
# Kopiere nach .env und passe an.

# === Server ===
HOST=127.0.0.1
PORT=9220

# === Database ===
# SQLite (default, file-based, kein Server noetig)
DATABASE_URL=sqlite:///D:/Entwicklung/PI-Dashboard 2/database/pi_dashboard.db
# PostgreSQL (production, optional):
# DATABASE_URL=postgresql+psycopg://user:pw@localhost:5432/pi_dashboard
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false  # SQL-Logging nur in Dev

# === PI-Agent-Pfade (fuer Migration + Integration) ===
PI_AGENT_DIR=C:\Users\uwean\.pi\agent
PI_BIN=pi
PI_CODING_AGENT_PKG=@earendil-works/pi-coding-agent

# === Migration ===
# Pfad zu v1.x JSON-Daten (default: ~/.pi/agent/kanban)
# V1_DATA_PATH wird automatisch aus PI_AGENT_DIR/kanban abgeleitet

# === Auth (default EIN) ===
# WICHTIG: Setze starke, zufaellige Werte. Unsichere Defaults werden abgelehnt.
AUTH_ENABLED=true
JWT_SECRET=__CHANGE_ME__
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24
ADMIN_USER=admin
# Passwort muss bcrypt-gehasht sein (beginnt mit $2a$/$2b$/$2y$).
# Klartext-Passwoerter funktionieren in der Uebergangsphase, erzeugen aber eine Warnung.
ADMIN_PASSWORD=__CHANGE_ME__

# === OpenBrain (optional) ===
OPENBRAIN_URL=
OPENBRAIN_ACCESS_KEY=

# === MiniMax / TTS / LLM (optional, wird nur bei KI-Features benoetigt) ===
MINIMAX_API_KEY=__CHANGE_ME__
KIMI_API_KEY=__CHANGE_ME__

# === CORS (Frontend-URLs) ===
CORS_ORIGINS=http://localhost:5181,http://127.0.0.1:5181,http://localhost:5173

# === Logging ===
LOG_LEVEL=INFO

# === Environment ===
# Erlaubte Werte: development, production, testing
# In production wird das Schema ausschliesslich ueber Alembic-Migrationen verwaltet.
ENV=development
