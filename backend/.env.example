# Pi Dashboard 2.0 Backend Config (BEISPIEL)
# Kopiere nach .env und passe an.

# === Server ===
HOST=127.0.0.1
PORT=9220

# === Database ===
# SQLite (default, file-based, kein Server noetig)
DATABASE_URL=sqlite:///D:/Entwicklung/PI-Dashboard 2/database/pi_dashboard.db
# PostgreSQL (production, optional):
# DATABASE_URL=postgresql+psycopg://user:pw@localhost:5432/pi_dashboard
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false  # SQL-Logging nur in Dev

# === PI-Agent-Pfade (fuer Migration + Integration) ===
PI_AGENT_DIR=C:\Users\uwean\.pi\agent
PI_BIN=pi
PI_CODING_AGENT_PKG=@earendil-works/pi-coding-agent

# === Migration ===
# Pfad zu v1.x JSON-Daten (default: ~/.pi/agent/kanban)
# V1_DATA_PATH wird automatisch aus PI_AGENT_DIR/kanban abgeleitet

# === Auth (default EIN) ===
# WICHTIG: Setze starke, zufaellige Werte. Unsichere Defaults werden abgelehnt.
AUTH_ENABLED=true
JWT_SECRET=__CHANGE_ME__PLEASE_SET_A_STRONG_32BYTE_SECRET
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24
ADMIN_USER=admin
# Passwort muss bcrypt-gehasht sein (beginnt mit $2a$/$2b$/$2y$).
# Klartext-Passwoerter funktionieren in der Uebergangsphase, erzeugen aber eine Warnung.
ADMIN_PASSWORD=__CHANGE_ME__PLEASE_SET_A_STRONG_ADMIN_PASSWORD

# === OpenBrain (optional) ===
# DEV-Brain: http://localhost:9303 (Key: ob-dev-key-2026)
OPENBRAIN_URL=
OPENBRAIN_ACCESS_KEY=

# === Sub-Agent-Spawner (swarm-spawner) ===
# Pfad zum spawn.sh aus dem PI-Agent-Setup.
# Wird von app/services/micro/sub_agent_service.py gelesen.
# Wichtig: Pfad MUSS existieren und ausfuehrbar sein (chmod +x auf Linux/Mac).
SPAWN_SH_PATH=
SUB_AGENT_TIMEOUT_MIN=30

# === SMproducer 3.0 OpenBrain MCP Bridge (optional) ===
# SMproducer lauscht per Default auf ZMQ tcp://127.0.0.1:3050
# SMPRODUCER_MCP_URL=tcp://127.0.0.1:3050
# SMPRODUCER_MCP_API_KEY=ob-dev-key-2026
# SMPRODUCER_MCP_TIMEOUT_S=30

# === ME4 External Services (OpenBrain MCP over ZMQ) ===
# Diese Services werden waehrend des Startups automatisch als Proxy-Tools
# im PI Dashboard MCP Bus registriert.
# ME4_TRANSCRIPT_ZMQ=tcp://127.0.0.1:5556
# ME4_TRANSCRIPT_API_KEY=
# ME4_SPEECH_SPLITTER_ZMQ=tcp://127.0.0.1:5560
# ME4_SPEECH_SPLITTER_API_KEY=
# ME4_NOTEBOOKLM_ZMQ=tcp://127.0.0.1:5558
# ME4_NOTEBOOKLM_API_KEY=

# === MCP-over-ZMQ Bus (optional) ===
# Default: tcp:// fuer externe Sub-Agenten (Prozess-grenzen); inproc:// nur fuer co-located Tests
PI_MCP_ROUTER_ENDPOINT=tcp://127.0.0.1:5555
PI_MCP_PUB_ENDPOINT=tcp://127.0.0.1:5556
# PI_MCP_API_KEY=set-a-strong-shared-key-for-external-subagents

# === MiniMax / TTS / LLM (optional, wird nur bei KI-Features benoetigt) ===
MINIMAX_API_KEY=__CHANGE_ME__
KIMI_API_KEY=__CHANGE_ME__

# === CORS (Frontend-URLs) ===
# JSON-Array-Format wird von pydantic_settings fuer list-Felder erwartet.
CORS_ORIGINS=["http://localhost:5181","http://127.0.0.1:5181","http://localhost:5173"]

# === Logging ===
LOG_LEVEL=INFO

# === Environment ===
# Erlaubte Werte: development, production, testing
# In production wird das Schema ausschliesslich ueber Alembic-Migrationen verwaltet.
ENV=development
