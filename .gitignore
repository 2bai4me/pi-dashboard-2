*.db
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite
# Aber: Migration-Scripts + Schema-Dumps sind OK
!database/migrations/

# ──── OS-spezifisch ────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

