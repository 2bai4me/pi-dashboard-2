.env.local
.env.*.local
*.key
*.pem
secrets.json

# ──── Logs / Runtime ───────────────────────────────────────────
*.log
logs/
*.log.*
runtime/
.cache/
tmp/
temp/

# ──── Pi-Agent-Daten (lokal pro User, nicht im Repo) ───────────
