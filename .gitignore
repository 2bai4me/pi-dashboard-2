*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
ENV/

# ──── Node / Frontend ───────────────────────────────────────────
node_modules/
dist/
build/
.vite/
.parcel-cache/
.next/
.nuxt/
*.local

# ──── IDE / Editor ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ──── Secrets / Config (lokal) ─────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
secrets.json

# ──── Logs / Runtime ───────────────────────────────────────────
*.log
logs/
*.log.*
runtime/
.cache/
tmp/
temp/

# ──── Pi-Agent-Daten (lokal pro User, nicht im Repo) ───────────
.pi-agent-data/
data/
sessions/

# ──── Tests / Coverage ─────────────────────────────────────────
coverage/
.nyc_output/
junit.xml
test-results/

# ──── Database (lokal, nicht im Repo) ─────────────────────────
# SQLite-Dateien enthalten User-Daten
*.db
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite
# Aber: Migration-Scripts + Schema-Dumps sind OK
!database/migrations/

# ──── OS-spezifisch ────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ──── Alembic ─────────────────────────────────────────────────
# alembic.ini wird committed, aber lokale Migration-Logs nicht
*.log.lck

# ──── Backend-spezifisch (lokal, nicht im Repo) ────────────
# Backend-Datenbanken separat von frontend/database/ ausschließen
backend/database/
# Eigene Python-Environments (falls nicht schon durch .venv/ abgedeckt)
backend/venv/
backend/env/
# Temporäre Cleanup-Scripts am Backend-Root (gehören in scripts/ wenn dauerhaft)
backend/cleanup_*.py
backend/consolidate_*.py
backend/restructure_*.py
backend/seed_*.py

# ──── UI-Screenshots & Audit-Berichte (lokal, nicht im Repo) ──
# Screenshots sind UI-Snapshots, gehören in docs/screenshots/ oder Wiki
screenshot_*.png
# Audit-Report ist eine lokale, temporäre Code-Analyse
audit_report.md

# ──── Neue Microservices (noch nicht integriert, eigene Repos) ──
# voice_gateway und voice_communicator sind eigenständige Services
# Sobald integriert: hier entfernen
voice_gateway/
voice_communicator/
